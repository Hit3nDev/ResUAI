# ResUAI Backend — Environment Variables
# =========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── AI Provider (Required) ──────────────────────────────────────────────────
# Free Groq key: https://console.groq.com → API Keys
# Key format: gsk_...
GROQ_API_KEY=your_groq_api_key_here

# ── JWT Authentication (Required) ───────────────────────────────────────────
# Generate a secure random secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters. Keep this private — it signs all auth tokens.
RESUAI_SECRET=your_jwt_secret_here_minimum_32_characters

# ── Server (Optional) ───────────────────────────────────────────────────────
# Port to listen on. Render.com sets this automatically.
PORT=8000

# ── CORS (Optional) ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * for development (default). Restrict to your domain in production.
# Example: ALLOW_ORIGINS=https://yourapp.vercel.app,https://www.yourapp.com
ALLOW_ORIGINS=*

# ── Security (Optional) ──────────────────────────────────────────────────────
# Set to 1 to hide /docs and /redoc in production
DOCS_DISABLED=0

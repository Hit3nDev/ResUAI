# ResUAI Frontend — Environment Variables
# =========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Backend API URL ──────────────────────────────────────────────────────────
# Development: leave blank (Next.js rewrites proxy to localhost:8000)
# Production:  set to your deployed backend URL
# Example: NEXT_PUBLIC_API_URL=https://resuai-api.onrender.com
NEXT_PUBLIC_API_URL=
